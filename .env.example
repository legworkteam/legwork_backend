APP_ENV=local
APP_NAME=Atelier Lens API
API_V1_PREFIX=/api/v1
POSTGRES_DB=atelierLens
POSTGRES_USER=atelier
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://atelier:CHANGE_ME@localhost:5432/atelierLens
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_BYTES_LONG
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
FILE_ROOT=./data
AI_HTTP_TIMEOUT_SECONDS=60
GUEST_PHOTO_LIMIT=3
TRYON_SOURCE_TTL_MINUTES=60
TRYON_RESULT_TTL_MINUTES=180
DIAGNOSIS_SOURCE_TTL_HOURS=24
JOB_TTL_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
